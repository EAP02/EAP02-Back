<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.codefactory</groupId>
    <artifactId>devnet</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>DevNet</name>
    <description>Red social para desarrolladores - Caso 13 - CodeF@ctory UdeA</description>

    <properties>
        <!--
          Java 17: baseline de Spring Boot 4.0 y version acordada por el equipo.
          Boot 4 recomienda 21 para virtual threads, que aqui estan desactivados de
          todas formas por el pinning del driver JDBC. Ver application.yml.
          El lineamiento 1.3 pide JDK 11 o superior, asi que 17 cumple.
        -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- La linea 3.x de springdoc es la que acompana a Boot 4 (la 2.x es de Boot 3) -->
        <springdoc.version>3.1.1</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <logstash-encoder.version>8.0</logstash-encoder.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <totp.version>1.7.1</totp.version>
        <archunit.version>1.3.0</archunit.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!--
          Spring Boot 4 ya no gestiona las versiones de Testcontainers en su BOM
          (si lo hacia en la linea 3.x). Se importa el BOM propio mas abajo, en
          dependencyManagement, para no tener que fijar version en cada artefacto.
        -->
        <testcontainers.version>1.20.4</testcontainers.version>

        <!--
          Umbral de cobertura, escalonado por sprint.

          El destino es 0.65: el lineamiento 3.5 pide 65 % y el 7.2 pide 40 % en el
          pipeline; el 1.2 ordena adoptar el mas exigente cuando difieren.

          Arranca en 0.00 porque con el esqueleto recien generado no hay logica que
          cubrir y el build fallaria el primer dia por una razon que no dice nada.

              Sprint 1  0.00   esqueleto y kernel
              Sprint 2  0.40   primeras HU implementadas
              Sprint 3  0.65   valor exigido por los lineamientos

          Bajarlo alguna vez es una decision del equipo que se documenta, no un
          ajuste silencioso para que pase el pipeline.
        -->
        <jacoco.linea.minima>0.00</jacoco.linea.minima>

        <sonar.projectKey>devnet</sonar.projectKey>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Fija de una vez la version de todo el ecosistema Testcontainers
              (junit-jupiter, postgresql y el nucleo), para que no puedan
              desalinearse entre si.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ============ Web y contrato ============ -->
        <!-- Boot 4 renombro spring-boot-starter-web a -webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============ Persistencia (ADR-003) ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          Boot 4 exige starter explicito para Flyway: declarar flyway-core a mano
          ya no activa la autoconfiguracion. El starter arrastra tambien el modulo
          de dialecto de PostgreSQL, que en Boot 3 habia que anadir aparte.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!--
          Obligatorio. Desde Flyway 10 el soporte de cada motor vive en su propio
          modulo y el nucleo no sabe hablar con ninguno: sin esto, el arranque falla
          con "Unsupported Database: PostgreSQL 16.x". El starter de Boot trae
          flyway-core, no el dialecto.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============ Seguridad (ADR-004) ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Boot 4 antepone 'security-' a los starters de OAuth2 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <!--
          Obligatorio para Argon2PasswordEncoder. Spring Security declara
          BouncyCastle como dependencia OPCIONAL: sin ella el bean se crea, pero
          revienta con NoClassDefFoundError la primera vez que codifica una clave.
          Ver ADR-004 para por que Argon2id y no BCrypt.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <!-- MFA TOTP (RFC 6238) -->
        <dependency>
            <groupId>dev.samstevens.totp</groupId>
            <artifactId>totp</artifactId>
            <version>${totp.version}</version>
        </dependency>
        <!-- Limite de tasa en /auth/** -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <!-- ============ Cache local ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- ============ Observabilidad ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          Logs estructurados en JSON (ADR-005).
          OJO: este encoder todavia depende de Jackson 2 (com.fasterxml), mientras
          Boot 4 gestiona Jackson 3 (tools.jackson). Conviven, pero deja dos Jackson
          en el classpath. Verificar en el primer build; si estorba, la alternativa
          es el soporte de logging estructurado que trae Boot de serie.
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-encoder.version}</version>
        </dependency>

        <!-- ============ Mapeo y utilidades ============ -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============ Pruebas ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 saco las anotaciones de test a modulos propios: @AutoConfigureMockMvc
          y @WebMvcTest ya no vienen con spring-boot-starter-test. Sin este starter,
          MockMvc no existe y las pruebas de controlador no compilan.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lineamientos 3.5: integracion contra base de datos real o contenedor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Verifica las fronteras entre modulos declaradas en ADR-001 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <!-- El orden importa: Lombok genera antes de que MapStruct lea. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <!-- Rompe el build si la cobertura cae del umbral -->
                        <id>umbral-cobertura</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.linea.minima}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <!-- Clases sin logica propia: no inflan ni castigan la cobertura -->
                        <exclude>**/DevNetApplication.class</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/*MapperImpl.class</exclude>
                        <exclude>**/package-info.class</exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
          Perfil para el pipeline. Activar con: mvn verify -Pci
          Separa las pruebas de integracion (Testcontainers) de las unitarias,
          para que un fallo de Docker no se confunda con un fallo de logica.
        -->
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>