# =============================================================================
#  DevNet - plantilla de variables de entorno
#
#  Copiar como .env y rellenar. El .env NO se versiona.
#  En Render van como variables del servicio; en el pipeline, como GitHub Secrets.
#
#  Lineamiento 7.3: "secretos externos al codigo".
#  Genera cada valor, no lo inventes:  openssl rand -base64 32
#
#  NINGUN valor real debe acabar en este archivo.
# =============================================================================

# ---------- Base de datos ----------
# En local, application.yml ya trae por defecto localhost/devnet con postgres:postgres.
# Estas variables son para integracion y produccion.
# Session pooler (puerto 5432), no el de transaccion (6543): Flyway toma un bloqueo de
# sesion para migrar y en modo transaccion se puede perder. Supabase -> Connect -> Session pooler.
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=devnet_app
DATABASE_PASSWORD=

# Usuario con el que Flyway aplica las migraciones (docs/bd/db-roles.sql).
# Si se omiten, Flyway usa DATABASE_USERNAME/PASSWORD. En cuanto la aplicacion
# conecte como devnet_app, son OBLIGATORIAS: devnet_app no puede cambiar el esquema.
# Con el pooler de Supabase, los usuarios llevan el sufijo: devnet_app.<project-ref>
FLYWAY_USERNAME=devnet_migrador
FLYWAY_PASSWORD=

# ---------- Firma de tokens ----------
# Par RSA para los JWT de acceso. Mientras no se definan, el backend genera un par
# EFIMERO en cada arranque y los tokens dejan de valer al reiniciar.
#
#   openssl genpkey -algorithm RSA -out privada.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in privada.pem -out publica.pem
#
# Pegar en una sola linea, reemplazando los saltos por \n.
# La clave PRIVADA solo existe en el backend. Nunca en el repositorio, ni en el
# Dockerfile, ni en la imagen.
JWT_CLAVE_PRIVADA=
JWT_CLAVE_PUBLICA=

# ---------- Red ----------
API_URL=http://localhost:8080
CORS_ORIGENES=http://localhost:3000,http://localhost:5173
PORT=8080