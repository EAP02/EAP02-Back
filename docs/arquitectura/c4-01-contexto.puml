@startuml c4-01-contexto
' DevNet - Red Social para Desarrolladores
' C4 Nivel 1: Diagrama de Contexto del Sistema
' Sin conexion a internet, reemplazar el include por: !include <C4/C4_Context>
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Nivel 1 - Contexto del sistema: DevNet

Person(desarrollador, "Desarrollador", "Miembro de la comunidad. Publica proyectos y repositorios, abre discusiones, comenta, reacciona, solicita colaborar y envia mensajes privados.")
Person(moderador, "Moderador", "Resuelve reportes, oculta contenido y aplica sanciones. Requiere MFA.")
Person(administrador, "Administrador", "Gestiona roles, catalogo de tecnologias y consulta reportes de comunidad y auditoria. Requiere MFA.")

System(devnet, "DevNet", "Red social especializada en desarrolladores. Expone una API REST versionada que concentra perfiles tecnicos, proyectos, discusiones, interaccion, mensajeria privada, moderacion y reportes de actividad.")

System_Ext(github, "GitHub", "Proveedor de identidad OIDC/OAuth 2.0 y origen de metadatos de repositorios publicados.")
System_Ext(supabase, "Supabase", "PostgreSQL administrado y almacenamiento de objetos para avatares e imagenes de proyecto.")
System_Ext(observabilidad, "Grafana Cloud", "Recolecta metricas expuestas por la API y sirve tableros y alertas.")

Rel(desarrollador, devnet, "Consume la API REST", "HTTPS/JSON")
Rel(moderador, devnet, "Revisa y resuelve reportes", "HTTPS/JSON")
Rel(administrador, devnet, "Administra y consulta reportes", "HTTPS/JSON")

Rel(devnet, github, "Autentica usuarios y lee metadatos de repositorios", "HTTPS / OAuth 2.0 + REST")
Rel(desarrollador, github, "Autoriza el acceso a su cuenta", "HTTPS / OAuth 2.0")
Rel(devnet, supabase, "Persiste datos y archivos", "TLS / PostgreSQL + HTTPS")
Rel(devnet, observabilidad, "Expone metricas para recoleccion", "HTTPS / Prometheus")

SHOW_LEGEND()

note right of devnet
  El perfil avanzado marca el frontend como N/A (lineamientos, 1.3).
  Los actores consumen la API a traves de Swagger UI y de
  colecciones de peticiones; no existe cliente web propio.
end note

@enduml