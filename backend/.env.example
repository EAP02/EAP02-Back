# =============================================================================
#  DevNet - plantilla de variables de entorno
#
#  Copiar como .env y rellenar. El .env NO se versiona (esta en .gitignore).
#  En Render van como variables del servicio; en el pipeline, como GitHub Secrets.
#
#  Lineamiento 7.3: "secretos externos al codigo".
#  Genera cada valor, no lo inventes:  openssl rand -base64 32
# =============================================================================

# ---------- Perfil ----------
# local | test | prod
SPRING_PROFILES_ACTIVE=local

# ---------- Base de datos (perfil prod) ----------
# La aplicacion se conecta con devnet_app, que NO puede modificar el esquema.
DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATASOURCE_USUARIO=devnet_app
DATASOURCE_CLAVE=

# Flyway corre con devnet_migrador, que si puede. Separar las dos cuentas es lo
# que hace de ddl-auto=validate una garantia y no una convencion.
# Ver docs/bd/db-roles.sql
FLYWAY_USUARIO=devnet_migrador
FLYWAY_CLAVE=

# ---------- Firma de tokens (ADR-004) ----------
# Par RSA para los JWT de acceso. Generar con:
#   openssl genpkey -algorithm RSA -out privada.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in privada.pem -out publica.pem
# Pegar en una sola linea reemplazando los saltos por \n.
JWT_CLAVE_PRIVADA=
JWT_CLAVE_PUBLICA=

# ---------- Cifrado del secreto TOTP ----------
# Clave AES de 256 bits en base64. El secreto de MFA se cifra a nivel de columna.
CIFRADO_MFA_CLAVE=

# ---------- GitHub como proveedor de identidad ----------
# Crear en https://github.com/settings/developers -> OAuth Apps
# Callback: <API_URL>/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Supabase Storage ----------
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_KEY=

# ---------- Red ----------
API_URL=http://localhost:8080
# Lista blanca de CORS, separada por comas. Vacia si no hay cliente web propio.
CORS_ORIGENES=http://localhost:3000

# ---------- Puerto ----------
# Render lo inyecta automaticamente. En local, 8080.
PORT=8080